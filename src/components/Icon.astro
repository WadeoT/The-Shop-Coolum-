---
const { name = 'arrow', class: className = '' } = Astro.props;
---
<svg class:list={['icon', className]} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'diagonal' && <path d="M6 18 18 6M6 6h12v12" />}
  {name === 'pin' && <><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 0 1 14 0Z"/><circle cx="12" cy="10" r="2.4"/></>}
  {name === 'phone' && <path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a15 15 0 0 1-7-7l2-2-2-5Z" />}
  {name === 'down' && <path d="M12 4v16m-6-6 6 6 6-6" />}
</svg>
