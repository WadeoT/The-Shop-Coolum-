---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import serifFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import italicFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-italic.woff2?url';
import sansFont from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
import { business } from '../data/site';
const { title = 'Good things, close to home.', description = 'Your local foodstore and coffee spot in Coolum Beach. Coffee, fresh food, groceries and little discoveries, opposite Coolum Surf Club.', image = '/images/hero-1280.webp' } = Astro.props;
const origin = import.meta.env.PUBLIC_SITE_URL;
const canonical = origin ? new URL(Astro.url.pathname, origin).href : undefined;
// Only the brief-confirmed identity is emitted until contact details are verified.
const schema = { '@context': 'https://schema.org', '@type': 'GroceryStore', name: business.name, ...(business.contactVerified ? { telephone: business.telephone, address: { '@type':'PostalAddress', streetAddress: business.street, addressLocality:'Coolum Beach', addressRegion:'QLD', postalCode:'4573', addressCountry:'AU' } } : {}), ...(origin ? {url: origin} : {}) };
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#344436"/>
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin/>
    <link rel="preload" href={italicFont} as="font" type="font/woff2" crossorigin/>
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin/>
    <title>{title} | The Shop @ Coolum</title><meta name="description" content={description}/>
    <meta property="og:title" content={`${title} | The Shop @ Coolum`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:locale" content="en_AU"/><meta property="og:site_name" content={business.name}/><meta property="og:image" content={origin ? new URL(image, origin).href : image}/><meta name="twitter:card" content="summary_large_image"/>
    {canonical && <><link rel="canonical" href={canonical}/><meta property="og:url" content={canonical}/></>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body id="top"><Header/><main id="main"><slot/></main><Footer/><script src="/js/motion.js" is:inline type="module"></script></body>
</html>
