---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Sun from '../components/Sun.astro';
import Thread from '../components/Thread.astro';
import CoffeeStory from '../components/CoffeeStory.astro';
import VisitCTA from '../components/VisitCTA.astro';
import { categories } from '../data/site';
---
<Layout>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-copy"><p class="eyebrow"><span class="location-dot"></span> COOLUM BEACH · QUEENSLAND</p><h1 id="hero-heading"><span>Good things,</span><span>close to</span><span><em>home.</em></span></h1><p class="hero-description">Your local foodstore, coffee spot and little<br class="desktop-break"/> corner of community — across from Coolum Surf Club.</p><div class="button-row"><a class="button" href="/visit/">Visit the shop <Icon name="diagonal" /></a><a class="text-link" href="#discover">Take a look around <Icon name="down" /></a></div><div class="hero-note"><span class="note-line"></span> A little everyday goodness.</div></div>
    <div class="hero-image-wrap"><Photo name="hero" alt="Illustrative flat white and golden croissant on a sunlit timber table" class="hero-photo" eager parallax sizes="(max-width: 700px) 100vw, 55vw"/><div class="hero-photo-label"><span>COFFEE. FOOD. EVERYDAY GOOD THINGS.</span><span>26° S / 153° E</span></div><div class="hero-stamp" aria-hidden="true"><span>A LITTLE LOCAL</span><Sun/><span>A LOT TO LOVE</span></div></div>
  </section>
  <div class="brand-strip" role="region" aria-label="Local knowledge. Local products. Local people."><div class="strip-track" aria-hidden="true">{Array.from({length:4},()=> <span>LOCAL KNOWLEDGE <Sun/> LOCAL PRODUCTS <Sun/> LOCAL PEOPLE <Sun/></span>)}</div><button class="motion-toggle" aria-pressed="false" aria-label="Pause decorative motion"><svg width="12" height="14" viewBox="0 0 12 14" aria-hidden="true"><path d="M3 1v12M9 1v12" stroke="currentColor" stroke-width="2"/></svg></button></div>
  <section id="discover" class="intro section-pad"><div><p class="eyebrow">WELCOME TO THE NEIGHBOURHOOD</p><h2>More than<br/>just a <em>shop.</em></h2></div><div class="intro-copy"><p class="lead">A morning coffee. Something for lunch.<br/>A few good things to take home.</p><p>Good coffee, fresh food, local favourites and the everyday essentials — all in one welcoming little spot in Coolum. Come for what you need. Stay for what you find.</p><a class="text-link" href="/our-story/">A little about us <Icon/></a><Thread/></div></section>
  <CoffeeStory/>
  <section class="discover-section section-pad" aria-labelledby="find-heading"><div class="section-heading"><div><p class="eyebrow">02 / EVERYDAY DISCOVERIES</p><h2 id="find-heading">A few of our<br/><em>favourite things.</em></h2></div><p>For your morning, your pantry,<br/>or just because.</p></div><div class="discovery-layout"><a class="discovery-photo-link" href="/groceries/"><Photo name="pantry" alt="Illustrative grocery bag with sourdough, leafy greens and seasonal produce" reveal/><span class="photo-caption"><span>GOOD THINGS TO TAKE HOME</span><Icon name="diagonal"/></span></a><div class="category-list">{categories.map(c=><a href={c.href}><span class="category-number">{c.number}</span><span><h3>{c.title}</h3><p>{c.text}</p></span><Icon name="diagonal"/></a>)}</div></div></section>
  <section class="local-section section-pad" aria-labelledby="local-heading"><div class="local-top"><p class="eyebrow">03 / ROOTED RIGHT HERE</p><span class="eyebrow">COOLUM BEACH, ALWAYS.</span></div><div class="local-composition"><h2 id="local-heading">Local knowledge.<br/>Local products.<br/><em>Local people.</em></h2><div class="local-side"><Sun/><p>There’s something good about knowing your local.</p><p>A familiar stop. An independent spirit. A place for everyday connections, and the small discoveries that make a day.</p><a class="text-link" href="/local/">Local matters <Icon/></a></div></div><Thread/><span class="local-endnote">GOOD THINGS, CLOSE TO HOME.</span></section>
  <section class="fresh-section section-pad" aria-labelledby="fresh-heading"><div class="fresh-copy"><p class="eyebrow">04 / A LITTLE SOMETHING GOOD</p><h2 id="fresh-heading">For the road.<br/>For the beach.<br/><em>For you.</em></h2><p class="body-copy">Fresh food, bread and pastries for wherever the day takes you. Pick up a little something on your way.</p><a class="text-link" href="/coffee-food/#fresh-food">Find your next good thing <Icon/></a><span class="handwritten">No occasion needed.</span></div><div class="fresh-image"><Photo name="bread" alt="Illustrative golden croissants and rustic bread on natural baking paper" reveal parallax/><span class="editorial-caption"><span>THE SIMPLE PLEASURES.</span><span>BEST ENJOYED SLOWLY.</span></span></div></section>
  <section class="community-note"><Sun/><p>A little shop.<br/>A whole lot of <em>Coolum.</em></p><a class="text-link" href="/our-story/">Our story <Icon/></a></section>
  <VisitCTA/>
</Layout>
