---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Sun from '../components/Sun.astro';
import Thread from '../components/Thread.astro';
import { business } from '../data/site';
---
<Layout title="Visit Us" description="Find The Shop @ Coolum opposite Coolum Surf Club, Shop 5, 1776/1784 David Low Way, Coolum Beach. Call 0400 301 078.">
  <section class="visit-page section-pad"><div class="visit-page-heading"><p class="eyebrow">JUST A LITTLE WAY FROM THE BEACH</p><h1>Come on <em>in.</em></h1><p class="lead">Coffee in hand. Coast on your doorstep.</p></div><div class="visit-page-grid"><div class="visit-details"><div><p class="eyebrow">FIND US</p><h2>Your little<br/><em>corner of Coolum.</em></h2><address>{business.street}<br/>{business.locality}</address><p>{business.location}.</p><a class="button" href={business.directions} target="_blank" rel="noopener noreferrer">Get directions <Icon name="diagonal"/></a></div><div class="visit-detail-bottom"><div><p class="eyebrow">GIVE US A CALL</p><a class="phone-link" href={`tel:${business.telephone}`}>{business.phone}<Icon name="phone"/></a></div><div><p class="eyebrow">OPENING HOURS</p>{business.hours ? <dl>{business.hours.map(day=><div><dt>{day.day}</dt><dd>{day.hours}</dd></div>)}</dl> : <p>Planning a visit?<br/>Please call for today’s opening hours.</p>}</div></div></div><div class="visit-poster" aria-hidden="true"><span class="eyebrow">THE SUNSHINE COAST, QUEENSLAND</span><Sun/><p>Good things.<br/>Sea breeze.<br/><em>See you soon.</em></p><Thread/><span class="eyebrow">THE SHOP @ COOLUM</span></div></div></section>
  <section class="visit-faq section-pad"><div><p class="eyebrow">BEFORE YOU DROP BY</p><h2>A few good<br/><em>things to know.</em></h2></div><div><details><summary>Where exactly is the shop?<Icon name="down"/></summary><p>Find us at {business.street}, {business.locality}, opposite Coolum Surf Club. Use the directions link above to plan your route.</p></details><details><summary>What’s available today?<Icon name="down"/></summary><p>Our food and grocery selection can change. Pop in to browse, or call {business.phone} if you’re looking for something specific.</p></details><details><summary>Can I ask about ingredients or dietary needs?<Icon name="down"/></summary><p>Of course. Please speak to the team about individual products, ingredients and preparation before ordering, and check the labels on packaged goods.</p></details></div></section>
</Layout>
